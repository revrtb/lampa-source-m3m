server {  
              listen 80;
              server_name streamcowboy.com www.streamcowboy.com;

	       location ~* \.(jpg|jpeg|gif|png|css|js|ico|woff|woff2|ttf|eot|svg)$ {
		       root /home/webuser/workspace/lampa-source/build/web;
			try_files $uri =404;
			expires 30d;
			add_header Cache-Control "public, must-revalidate";
	      }

              location / {  
                           proxy_pass http://localhost:3000;  
                           proxy_http_version 1.1;  
                           proxy_set_header Upgrade $http_upgrade;  
                           proxy_set_header Connection 'upgrade';  
                           proxy_set_header Host $host;  
                           proxy_cache_bypass $http_upgrade;  
               }  

	      location = /wyd2eadasdq {
		alias /home/webuser/workspace/lampa-source/static/revrtb.html;
		default_type text/html;
	      }

	      location = /asdga87dga8gd {
